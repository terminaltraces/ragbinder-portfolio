modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "portfolio-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "portfolio-static"

[[workflows.workflow]]
name = "portfolio-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test scripts/verify-portfolio.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "portfolio-static"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/portfolio run build && node --test scripts/verify-static.mjs"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
